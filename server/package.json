{
  "name": "floo-api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "test": "node --test test/calculation.test.js",
    "test:integration": "node --test test/integration.test.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed:all": "sequelize-cli db:seed:all",
    "db:migrate:undo": "sequelize-cli db:migrate:undo"
  },
  "dependencies": {
    "express": "^5.1.0",
    "sequelize": "^6.37.7",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.0",
    "sequelize-cli": "^6.6.3",
    "dotenv": "^17.2.0"
  }
}
